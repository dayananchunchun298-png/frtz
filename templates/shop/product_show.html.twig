{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - FRTZ PawCare{% endblock %}

{% block body %}
<div class="page-hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ product.name }}</h1>
        <p class="hero-subtitle">{{ product.category|title }} for {{ product.petType|title }}</p>
        <div class="hero-decoration">🛍️</div>
    </div>
</div>

<div class="product-detail-container">
    <div class="product-detail-grid">
        <div class="product-image-section">
            {% if product.image %}
                <img src="{{ product.image }}" alt="{{ product.name }}" class="product-main-image">
            {% else %}
                <div class="no-image-large">
                    {% if product.petType == 'dog' %}
                        🥩
                    {% elseif product.petType == 'cat' %}
                        🐟
                    {% elseif product.petType == 'bird' %}
                        🌾
                    {% elseif product.petType == 'fish' %}
                        🐟
                    {% elseif product.petType == 'small_pet' %}
                        🌰
                    {% else %}
                        🥣
                    {% endif %}
                </div>
            {% endif %}
        </div>
        
        <div class="product-info-section">
            <div class="product-header">
                <h2>{{ product.name }}</h2>
                <div class="product-badges">
                    <span class="category-badge">{{ product.category|title }}</span>
                    {% if product.stock <= 5 %}
                        <span class="stock-badge low-stock">Low Stock</span>
                    {% endif %}
                </div>
            </div>
            
            <div class="product-price-section">
                <span class="price">₱{{ product.price }}</span>
            </div>
            
            <div class="product-description">
                <h3>Description</h3>
                <p>{{ product.description ?: 'No description available for this product.' }}</p>
            </div>
            
            <div class="product-details">
                <div class="detail-item">
                    <span class="detail-label">Pet Type:</span>
                    <span class="detail-value">
                        {% if product.petType == 'dog' %}
                            🥣 Dog Food
                        {% elseif product.petType == 'cat' %}
                            🥣 Cat Food
                        {% elseif product.petType == 'bird' %}
                            🥣 Bird Food
                        {% elseif product.petType == 'fish' %}
                            🥣 Fish Food
                        {% elseif product.petType == 'small_pet' %}
                            🥣 Small Pet Food
                        {% else %}
                            🥣 All Pets
                        {% endif %}
                    </span>
                </div>
                
                <div class="detail-item">
                    <span class="detail-label">Category:</span>
                    <span class="detail-value">{{ product.category|title }}</span>
                </div>
                
                <div class="detail-item">
                    <span class="detail-label">Stock:</span>
                    <span class="detail-value">
                        {% if product.stock > 0 %}
                            <span class="in-stock">✅ {{ product.stock }} available</span>
                        {% else %}
                            <span class="out-of-stock">❌ Out of Stock</span>
                        {% endif %}
                    </span>
                </div>
                
                <div class="detail-item">
                    <span class="detail-label">Added:</span>
                    <span class="detail-value">{{ product.createdAt|date('M d, Y') }}</span>
                </div>
            </div>
            
            <div class="product-actions">
                {% if product.stock > 0 %}
                    <button class="btn btn-primary add-to-cart" data-product-id="{{ product.id }}" onclick="addToCart({{ product.id }})">
                        <span class="btn-icon">🛒</span>
                        <span class="btn-text">Add to Cart</span>
                    </button>
                {% else %}
                    <button class="btn btn-disabled" disabled>
                        <span class="btn-icon">❌</span>
                        <span class="btn-text">Out of Stock</span>
                    </button>
                {% endif %}
                
                <a href="{{ path('app_shop') }}" class="btn btn-outline">
                    <span class="btn-icon">←</span>
                    <span class="btn-text">Back to Shop</span>
                </a>
            </div>
        </div>
    </div>
    
    <div class="related-products">
        <h3>You might also like</h3>
        <p>Check out other products in the same category</p>
        <a href="{{ path('app_shop', {'category': product.category}) }}" class="btn btn-outline">
            <span class="btn-icon">🔍</span>
            <span class="btn-text">View More {{ product.category|title }}</span>
        </a>
    </div>
</div>

<script>
// Add to cart functionality
function addToCart(productId) {
    fetch(`/cart/add/${productId}`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Show success message
            showNotification('Product added to cart!', 'success');
            updateCartCount();
        } else {
            showNotification('Error: ' + data.message, 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showNotification('Error adding product to cart', 'error');
    });
}

function showNotification(message, type = 'success') {
    // Create notification element
    const notification = document.createElement('div');
    notification.className = `notification ${type}`;
    notification.innerHTML = `
        <div class="notification-content">
            <span class="notification-icon">${type === 'success' ? '✅' : '❌'}</span>
            <span class="notification-text">${message}</span>
        </div>
    `;
    
    // Add to page
    document.body.appendChild(notification);
    
    // Show notification
    setTimeout(() => notification.classList.add('show'), 100);
    
    // Remove after 3 seconds
    setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => notification.remove(), 300);
    }, 3000);
}

function updateCartCount() {
    fetch('/cart/count')
    .then(response => response.json())
    .then(data => {
        const cartCount = document.querySelector('.cart-count');
        if (cartCount) {
            cartCount.textContent = data.count;
            cartCount.style.display = data.count > 0 ? 'inline' : 'none';
        }
    });
}

// Update cart count on page load
document.addEventListener('DOMContentLoaded', function() {
    updateCartCount();
});
</script>
{% endblock %}
