{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ product.name }} - Admin - FRTZ PawCare{% endblock %}

{% block body %}
<div class="page-hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ product.name }}</h1>
        <p class="hero-subtitle">Product Details</p>
        <div class="hero-decoration">🔧</div>
    </div>
</div>

<div class="appointment-detail-container">
    <div class="appointment-detail-card">
        <div class="card-header">
            <div class="header-content">
                <h2>{{ product.name }}</h2>
                <div class="appointment-id">Product #{{ product.id }}</div>
            </div>
            <div class="pet-avatar">
                {% if product.petType == 'dog' %}
                    🐕
                {% elseif product.petType == 'cat' %}
                    🐱
                {% elseif product.petType == 'bird' %}
                    🐦
                {% elseif product.petType == 'fish' %}
                    🐠
                {% else %}
                    🐾
                {% endif %}
            </div>
        </div>
        
        <div class="card-body">
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-icon">🏷️</div>
                    <div class="detail-content">
                        <span class="detail-label">Product Name</span>
                        <span class="detail-value">{{ product.name }}</span>
                    </div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-icon">📝</div>
                    <div class="detail-content">
                        <span class="detail-label">Description</span>
                        <span class="detail-value">{{ product.description ?: 'No description provided' }}</span>
                    </div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-icon">💰</div>
                    <div class="detail-content">
                        <span class="detail-label">Price</span>
                        <span class="detail-value">₱{{ product.price }}</span>
                    </div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-icon">🏷️</div>
                    <div class="detail-content">
                        <span class="detail-label">Category</span>
                        <span class="detail-value">{{ product.category|title }}</span>
                    </div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-icon">
                        {% if product.petType == 'dog' %}
                            🐕
                        {% elseif product.petType == 'cat' %}
                            🐱
                        {% elseif product.petType == 'bird' %}
                            🐦
                        {% elseif product.petType == 'fish' %}
                            🐠
                        {% else %}
                            🐾
                        {% endif %}
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">Pet Type</span>
                        <span class="detail-value">
                            {% if product.petType == 'dog' %}
                                Dog 🐕
                            {% elseif product.petType == 'cat' %}
                                Cat 🐱
                            {% elseif product.petType == 'bird' %}
                                Bird 🐦
                            {% elseif product.petType == 'fish' %}
                                Fish 🐠
                            {% elseif product.petType == 'small_pet' %}
                                Small Pet 🐹
                            {% else %}
                                All Pets 🐾
                            {% endif %}
                        </span>
                    </div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-icon">📦</div>
                    <div class="detail-content">
                        <span class="detail-label">Stock</span>
                        <span class="detail-value">
                            {% if product.stock > 0 %}
                                {{ product.stock }} available
                            {% else %}
                                Out of Stock
                            {% endif %}
                        </span>
                    </div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-icon">📅</div>
                    <div class="detail-content">
                        <span class="detail-label">Created</span>
                        <span class="detail-value">{{ product.createdAt|date('M d, Y g:i A') }}</span>
                    </div>
                </div>
                
                {% if product.updatedAt %}
                <div class="detail-item">
                    <div class="detail-icon">🔄</div>
                    <div class="detail-content">
                        <span class="detail-label">Last Updated</span>
                        <span class="detail-value">{{ product.updatedAt|date('M d, Y g:i A') }}</span>
                    </div>
                </div>
                {% endif %}
            </div>
            
            {% if product.image %}
            <div class="product-image-section">
                <h3>Product Image</h3>
                <img src="{{ product.image }}" alt="{{ product.name }}" class="product-image">
            </div>
            {% endif %}
        </div>
        
        <div class="card-actions">
            <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}" class="btn btn-primary">
                <span class="btn-icon">✏️</span>
                <span class="btn-text">Edit Product</span>
            </a>
            <a href="{{ path('app_admin') }}" class="btn btn-outline">
                <span class="btn-icon">←</span>
                <span class="btn-text">Back to Admin</span>
            </a>
        </div>
        
        <div class="danger-zone">
            <h3>⚠️ Danger Zone</h3>
            <p>Permanently delete this product. This action cannot be undone.</p>
            <form method="post" action="{{ path('app_admin_product_delete', {'id': product.id}) }}" onsubmit="return confirm('Are you sure you want to delete this product?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                <button type="submit" class="btn btn-danger">
                    <span class="btn-icon">🗑️</span>
                    <span class="btn-text">Delete Product</span>
                </button>
            </form>
        </div>
    </div>
    
    <div class="appointment-info">
        <div class="info-card">
            <h3>📊 Product Statistics</h3>
            <ul>
                <li><strong>Status:</strong> {{ product.isActive ? 'Active' : 'Inactive' }}</li>
                <li><strong>Stock Level:</strong> {{ product.stock }} units</li>
                <li><strong>Price:</strong> ${{ product.price }}</li>
                <li><strong>Category:</strong> {{ product.category|title }}</li>
            </ul>
        </div>
        
        <div class="info-card">
            <h3>🔗 Quick Actions</h3>
            <div class="quick-actions">
                <a href="{{ path('app_shop_product_show', {'id': product.id}) }}" class="btn btn-outline" target="_blank">
                    <span class="btn-icon">👁️</span>
                    <span class="btn-text">View in Shop</span>
                </a>
                <a href="{{ path('app_shop', {'category': product.category}) }}" class="btn btn-outline" target="_blank">
                    <span class="btn-icon">🔍</span>
                    <span class="btn-text">View Category</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
