<div class="appointments-grid">
    {% for appointment in appointments %}
        <div class="appointment-card" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
            <div class="card-header">
                <div class="pet-info">
                    <h3>{{ appointment.Name }}</h3>
                    <span class="pet-emoji">
                        {% if appointment.PetType == 'dog' %}
                            🐕
                        {% elseif appointment.PetType == 'cat' %}
                            🐱
                        {% else %}
                            🐾
                        {% endif %}
                    </span>
                </div>
                <div class="appointment-id">#{{ appointment.id }}</div>
            </div>

            <div class="card-body">
                <div class="appointment-details">
                    <div class="detail-item">
                        <span class="detail-icon">
                            {% if appointment.PetType == 'dog' %}
                                🐕
                            {% elseif appointment.PetType == 'cat' %}
                                🐱
                            {% else %}
                                🐾
                            {% endif %}
                        </span>
                        <div class="detail-content">
                            <span class="detail-label">Pet Type</span>
                            <span class="detail-value">
                                {% if appointment.PetType == 'dog' %}
                                    Dog 🐕
                                {% elseif appointment.PetType == 'cat' %}
                                    Cat 🐱
                                {% else %}
                                    {{ appointment.PetType|title }}
                                {% endif %}
                            </span>
                        </div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-icon">📅</span>
                        <div class="detail-content">
                            <span class="detail-label">Date & Time</span>
                            <span class="detail-value">
                                {% if appointment.AppointmentDate %}
                                    {{ appointment.AppointmentDate|date('M d, Y') }}
                                    <br>
                                    <small>{{ appointment.AppointmentDate|date('g:i A') }}</small>
                                {% else %}
                                    <em>Not scheduled</em>
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-actions">
                <a href="{{ path('app_admin_appointment_show', {'id': appointment.id}) }}" class="btn btn-outline">
                    <span class="btn-icon">👁️</span>
                    View Details
                </a>
                <a href="{{ path('app_admin_appointment_edit', {'id': appointment.id}) }}" class="btn btn-primary">
                    <span class="btn-icon">✏️</span>
                    Edit
                </a>
                <form method="post" action="{{ path('app_admin_appointment_delete', {'id': appointment.id}) }}" onsubmit="return confirm('Are you sure you want to delete this appointment?');" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <span class="btn-icon">🗑️</span>
                        Delete
                    </button>
                </form>
            </div>

            <div class="card-status">
                {% if appointment.AppointmentDate and appointment.AppointmentDate > date() %}
                    <span class="status-badge status-upcoming">Upcoming</span>
                {% elseif appointment.AppointmentDate and appointment.AppointmentDate <= date() %}
                    <span class="status-badge status-completed">Completed</span>
                {% else %}
                    <span class="status-badge status-pending">Pending</span>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="empty-state">
            <div class="empty-icon">🐾</div>
            <h3>No Appointments Yet</h3>
            <p>Start managing appointments by creating the first one.</p>
            <a href="{{ path('app_admin_appointment_new') }}" class="btn btn-primary">
                <span class="btn-icon">+</span>
                <span class="btn-text">Create First Appointment</span>
            </a>
        </div>
    {% endfor %}
</div>
