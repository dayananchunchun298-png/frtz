{% extends 'admin/base_admin.html.twig' %}

{% block title %}Edit Appointment - Admin - FRTZ PawCare{% endblock %}

{% block body %}
<div class="page-hero">
    <div class="hero-content">
        <h1 class="hero-title">Edit Appointment</h1>
        <p class="hero-subtitle">Update appointment details</p>
        <div class="hero-decoration">🔧</div>
    </div>
</div>

<div class="appointment-page-container">
    <div class="appointment-card">
        <div class="card-header">
            <h2>Edit Appointment Details</h2>
            <p>Update the appointment details below</p>
        </div>
        
        {{ include('appointment/_form.html.twig', {'button_label': 'Update Appointment'}) }}
        
        <div class="form-actions-secondary">
            <a href="{{ path('app_admin') }}" class="btn btn-outline">
                <span class="btn-icon">←</span>
                <span class="btn-text">Back to Admin Dashboard</span>
            </a>
            <a href="{{ path('app_admin_appointment_show', {'id': appointment.id}) }}" class="btn btn-secondary">
                <span class="btn-icon">👁️</span>
                <span class="btn-text">View Details</span>
            </a>
        </div>
        
        <div class="danger-zone">
            <h3>⚠️ Danger Zone</h3>
            <p>Permanently delete this appointment. This action cannot be undone.</p>
            <form method="post" action="{{ path('app_admin_appointment_delete', {'id': appointment.id}) }}" onsubmit="return confirm('Are you sure you want to delete this appointment?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
                <button type="submit" class="btn btn-danger">
                    <span class="btn-icon">🗑️</span>
                    <span class="btn-text">Delete Appointment</span>
                </button>
            </form>
        </div>
    </div>
    
    <div class="appointment-info">
        <div class="info-card">
            <h3>📝 Editing Tips</h3>
            <ul>
                <li>Update date and time as needed</li>
                <li>Ensure all information is accurate</li>
                <li>Changes will be reflected immediately</li>
                <li>Contact pet owner if major changes are made</li>
            </ul>
        </div>
        
        <div class="info-card">
            <h3>📞 Need Help?</h3>
            <div class="contact-info">
                <p><strong>Phone:</strong> (555) 123-PAWS</p>
                <p><strong>Email:</strong> care@fritzpawcare.com</p>
                <p><strong>Hours:</strong> Mon-Fri 8AM-6PM</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
