<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}FRTZ PawCare{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 fill=%22%23000000%22/><path d=%22M 20 80 Q 64 20 108 80 L 108 100 L 20 100 Z%22 fill=%22%231e3a8a%22/><path d=%22M 40 80 Q 25 75 20 65 Q 25 55 30 55 Q 35 50 40 52 Q 45 50 50 55 Q 55 55 60 65 Q 55 75 40 80 Z%22 fill=%22%231e3a8a%22/><path d=%22M 88 80 Q 73 75 68 65 Q 73 55 78 55 Q 83 50 88 52 Q 93 50 98 55 Q 103 55 108 65 Q 103 75 88 80 Z%22 fill=%22%23ff6b35%22/></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header>
        <div class="brand">
            <h1>FRTZ PawCare</h1>
            <p>Your pet's health is our top priority</p>
        </div>
        <img src="/logo.svg" alt="FRTZ PawCare logo" class="brand-logo" />
    </header>

    {% set currentRoute = app.request.attributes.get('_route') %}

    <nav class="main-nav">
        <div class="main-nav-left">
            <a href="{{ path('app_home') }}" class="main-nav-link {% if currentRoute == 'app_home' %}is-active{% endif %}">Home</a>
            <a href="{{ path('app_about') }}" class="main-nav-link {% if currentRoute == 'app_about' %}is-active{% endif %}">About</a>
            <a href="{{ path('app_shop') }}" class="main-nav-link {% if currentRoute == 'app_shop' %}is-active{% endif %}">Shop</a>
            <a href="{{ path('app_appointment_index') }}" class="main-nav-link {% if currentRoute == 'app_appointment_index' %}is-active{% endif %}">Appointments</a>
            <a href="{{ path('app_contact') }}" class="main-nav-link {% if currentRoute == 'app_contact' %}is-active{% endif %}">Contact</a>
        </div>

        <div class="main-nav-right">
            {% if app.user %}
                <a href="{{ path('app_profile') }}" class="main-nav-link {% if currentRoute == 'app_profile' %}is-active{% endif %}">My Account</a>
                {% if is_granted('ROLE_STAFF') and not is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_staff_dashboard') }}" class="main-nav-link {% if currentRoute == 'app_staff_dashboard' %}is-active{% endif %}">Staff</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin') }}" class="main-nav-link {% if currentRoute == 'app_admin' %}is-active{% endif %}">Admin</a>
                {% endif %}
                <form method="post" action="{{ path('app_logout') }}" class="logout-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="main-nav-link main-nav-link-cta logout-form-btn">Logout</button>
                </form>
            {% else %}
                <a href="{{ path('app_login') }}" class="main-nav-link {% if currentRoute == 'app_login' %}is-active{% endif %}">Login</a>
                <a href="{{ path('app_register') }}" class="main-nav-link main-nav-link-cta">Sign up</a>
            {% endif %}

            <a href="{{ path('app_cart') }}" class="cart-link main-nav-cart {% if currentRoute == 'app_cart' %}is-active{% endif %}">
                <span class="cart-icon">🛒</span>
                <span class="main-nav-cart-text">Cart</span>
                <span class="cart-count" style="display: none;">0</span>
            </a>
        </div>
    </nav>

    {% for message in app.flashes('success') %}
        <div class="flash-message success">
            <div class="flash-content">
                <span class="flash-icon">✅</span>
                <span class="flash-text">{{ message }}</span>
            </div>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="flash-message error">
            <div class="flash-content">
                <span class="flash-icon">⚠️</span>
                <span class="flash-text">{{ message }}</span>
            </div>
        </div>
    {% endfor %}

    {% block body %}{% endblock %}

    <footer>
        <p>&copy; {{ "now"|date("Y") }} FRTZ PawCare. All rights reserved.</p>
    </footer>
    </body>
</html>
