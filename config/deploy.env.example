# Railway / production environment variables (set in Railway dashboard, not in git).
#
# Required
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<random-32+-chars>
APP_URL=https://your-app.up.railway.app
DEFAULT_URI=https://your-app.up.railway.app
DATABASE_URL=<from Railway MySQL plugin — linked variable>
JWT_PASSPHRASE=<stable-secret — keys auto-generated on first boot>
#
# Brevo SMTP (prod mailer uses these via config/packages/mailer.yaml)
BREVO_SMTP_USER=<login@smtp-brevo.com>
BREVO_SMTP_KEY=<xsmtpsib-...>
MAILER_FROM_ADDRESS=<verified sender in Brevo>
MAILER_FROM_NAME=FRTZ PawCare
#
# Google OAuth (staff login) — add redirect URI in Google Cloud Console:
#   https://your-app.up.railway.app/connect/google/check
GOOGLE_CLIENT_ID=<....apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-...>
GOOGLE_STAFF_ALLOWED_DOMAIN=
#
# API / mobile CORS (adjust for your Expo or web origin)
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^exp://.*
#
# Optional: Railway sets RAILWAY_PUBLIC_DOMAIN; entrypoint builds APP_URL if APP_URL is empty.
# Public networking port: 8000 (matches nginx listen / PORT env default).
#
# After first deploy (if migrations did not run automatically):
#   php bin/console doctrine:migrations:migrate --no-interaction
#   php bin/console app:create-default-admin
#   php bin/console app:create-demo-customer
