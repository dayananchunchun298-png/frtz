# Copy to .env.local and fill in real values (never commit secrets).
# cp .env.example .env.local

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=generate-a-random-32-char-string

APP_URL=http://127.0.0.1:8000
DEFAULT_URI=http://127.0.0.1:8000

DATABASE_URL="mysql://FRTZPAWS:121212@127.0.0.1:3306/my?serverVersion=8.0&charset=utf8mb4"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Option A: full DSN (local dev)
MAILER_DSN=smtp://your-brevo-login@smtp-brevo.com:your-smtp-key@smtp-relay.brevo.com:587

# Option B: split vars (Railway / prod — used by config/packages/mailer.yaml when@prod)
BREVO_SMTP_USER=your-brevo-login@smtp-brevo.com
BREVO_SMTP_KEY=your-brevo-smtp-key
MAILER_FROM_ADDRESS=your-verified-sender@example.com
MAILER_FROM_NAME="FRTZ PawCare"

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^exp://.*'

JWT_PASSPHRASE=generate-a-long-random-passphrase

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_STAFF_ALLOWED_DOMAIN=

CONTACT_FORM_EMBED_URL=https://forms.gle/your-form-id

MYSQL_ROOT_PASSWORD=121212
MYSQL_DATABASE=my
MYSQL_USER=FRTZPAWS
MYSQL_PASSWORD=121212
APP_PORT=8000
